# TINGLE / Karen's Ear — Frontend Environment Configuration Template
# Copy to .env.local or .env for environment configuration.
# DO NOT store private credentials or secrets in client-visible VITE_* variables.

# Backend REST API Base URL
# - Production (Render): https://tingle-backend.onrender.com
# - Local development (direct): http://127.0.0.1:8000
# - Local development (via Vite dev proxy): leave empty or /api
VITE_API_BASE_URL=

# Backend Real-Time WebSocket URL
# - Production (Render): wss://tingle-backend.onrender.com/ws/events
# - Local development (direct): ws://127.0.0.1:8000/ws/events
# - Local development (via Vite dev proxy): leave empty (defaults to /ws/events)
VITE_WS_URL=

# Operator Identifier for Human Overrides and Review Attribution
# Default: console-operator
VITE_OPERATOR_ID=console-operator

# Cartographic Map Provider
# The tactical map operates on 100% Leaflet with dark tactical styling.
# No third-party API keys or billing accounts are required.
