# Karen's Ear — Environment Configuration Template
# Copy to .env and configure local/production values. Do NOT commit .env.

# Database (PostgreSQL)
# Local example: postgresql://postgres:password@localhost:5432/karen_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Hugging Face & ML Pipeline
HF_DATASET=LanD-FBK/crisitext
ML_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Service Endpoints
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Operational Engine Settings
DUPLICATE_SIMILARITY_THRESHOLD=0.85
LOG_LEVEL=INFO
